# ==============================================================================
# Database Configuration (PostgreSQL & SSH Tunnel)
# ==============================================================================
# Apakah database diakses melalui SSH Tunnel? ("true" atau "false")
SSH_ENABLED="true"

# Kredensial SSH Server / Bastion
SSH_HOST="your-ssh-host.com"
SSH_PORT="22"
SSH_USER="your-ssh-username"
SSH_PASSWORD="your-ssh-password"
# SSH_KEY_PATH="" # Opsional: path ke private key jika tidak menggunakan password

# Kredensial Database PostgreSQL (dilihat dari remote SSH server)
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_USER="your-db-user"
DB_PASSWORD="your-db-password"
DB_NAME="your-db-name"
DB_SCHEMA="public"

# Multi-Tenancy Database Name (Menteri & Wakil Menteri)
# Jika DB_NAME_MENAKER / DB_NAME_WAMEN diisi, sistem menggunakan database terpisah per scope
DB_NAME_MENAKER="pwa_protokol_menaker"
DB_NAME_WAMEN="appprotowamen_db"

# Konfigurasi Koneksi Database Wamen (Wakil Menteri)
DATABASE_URL_WAMEN="postgresql://appproto_user:DmCOkBzYCCUO@localhost:5432/appprotowamen_db?schema=public"
# DB_HOST_WAMEN="127.0.0.1"
# DB_PORT_WAMEN="5432"
# DB_USER_WAMEN="appproto_user"
# DB_PASSWORD_WAMEN="DmCOkBzYCCUO"
# DB_SCHEMA_WAMEN="public"

# Port lokal untuk forwarding SSH Tunnel (misal 5433 agar tidak bentrok dengan PostgreSQL lokal 5432)
DB_LOCAL_PORT="5433"

# URL Koneksi Prisma (Otomatis dibangun jika DB_USER diisi, atau atur manual jika diperlukan)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@127.0.0.1:5433/${DB_NAME}?schema=${DB_SCHEMA}&sslmode=prefer"
DIRECT_URL="postgresql://${DB_USER}:${DB_PASSWORD}@127.0.0.1:5433/${DB_NAME}?schema=${DB_SCHEMA}&sslmode=prefer"

# ==============================================================================
# 1. Konfigurasi Chat & Pemahaman Intention (OpenRouter - Free Model Tanpa Biaya)
# ==============================================================================
# API Key OpenRouter khusus untuk chat & understanding intention (misal dari https://openrouter.ai/settings/keys)
CHAT_API_KEY=""
# Model free OpenRouter (default: "openrouter/free" atau model berakhiran ":free")
CHAT_MODEL="openrouter/free"

# ==============================================================================
# 2. Konfigurasi Ekstraksi Dokumen PDF & Rekomendasi Perihal
# ==============================================================================
# Provider untuk ekstraksi PDF: "gemini" atau "openrouter"
PDF_EXTRACTION_PROVIDER="gemini"
# API Key khusus untuk ekstraksi PDF (misal Google Gemini API Key: AIzaSy...)
PDF_EXTRACTION_API_KEY=""
# Model khusus untuk ekstraksi PDF (misal "gemini-2.5-flash")
PDF_EXTRACTION_MODEL="gemini-2.5-flash"

# Admin Support Contact (Ditampilkan saat nomor tidak terdaftar)
ADMIN_CONTACT="0812-xxxx-xxxx (Admin Tim IT)"

# ==============================================================================
# 3. Penyimpanan Berkas Surat Masuk (Local Server / Symlink Directory)
# ==============================================================================
# 3. Penyimpanan Berkas Surat Masuk & Dokumen (Files Root / Symlink)
# ==============================================================================
# Root direktori penyimpanan berkas di server aplikasi Wamen
FILES_ROOT="/home/gatsu51/app/v3-protokolwamen.gatsu51.com/files"

# Path folder penyimpanan lokal untuk file PDF surat yang diunggah melalui chatbot.
# Di server production, folder ini dapat di-symlink ke folder direktori aplikasi utama:
# Contoh Menaker : ln -s /path/ke/aplikasi_menaker/storage/app/public/files/letter ./storage/letters
# Contoh Wamen   : ln -s /home/gatsu51/app/v3-protokolwamen.gatsu51.com/files/letter ./storage/letters_wamen
UPLOAD_STORAGE_PATH="./storage/letters"
UPLOAD_STORAGE_PATH_WAMEN="./storage/letters_wamen"
TEMP_STORAGE_PATH="./storage/temp"
PRIVATE_STORAGE_PATH="./storage/letters"

# Base URL publik untuk mengakses berkas surat
FILE_URL="https://your-domain.com/files/letter/"
FILE_URL_WAMEN="https://v3-protokolwamen.gatsu51.com/files/letter/"

# ==============================================================================
# 4. Penyimpanan Berkas Disposisi (Local Server / Symlink Directory)
# ==============================================================================
# Path folder penyimpanan lokal untuk file PDF / Gambar lembar disposisi yang diunggah.
# Di server production, folder ini dapat di-symlink ke folder direktori aplikasi utama:
# Contoh Menaker : ln -s /path/ke/aplikasi_menaker/storage/app/public/files/disposition ./storage/dispositions
# Contoh Wamen   : ln -s /home/gatsu51/app/v3-protokolwamen.gatsu51.com/files/disposition ./storage/dispositions_wamen
DISPOSITION_STORAGE_PATH="./storage/dispositions"
DISPOSITION_STORAGE_PATH_WAMEN="./storage/dispositions_wamen"
DISPOSITION_FILE_URL="https://your-domain.com/files/disposition/"
DISPOSITION_FILE_URL_WAMEN="https://v3-protokolwamen.gatsu51.com/files/disposition/"

# ==============================================================================
# 5. Meta WhatsApp Cloud API Configuration
# ==============================================================================
# Mode Provider: "baileys" (default multi-device) atau "meta" (Cloud API)
WHATSAPP_PROVIDER="baileys"

# Token verifikasi rahasia yang dimasukkan ke form Webhook di Meta Developer Dashboard
META_VERIFY_TOKEN="your-verify-token-here"

# Port lokal server webhook
META_WEBHOOK_PORT=3000

# Access Token dari Meta (Temporary Token 24 jam atau Permanent System User Token)
META_WA_TOKEN=""

# Phone Number ID dari Meta Developer Dashboard (deretan angka ID unik nomor bot)
META_PHONE_NUMBER_ID=""
# Opsional: Phone Number ID nomor terpisah untuk Protokol Wamen jika menggunakan 2 nomor WA berbeda
META_PHONE_NUMBER_ID_WAMEN=""

# Nonaktifkan Cloudflare Auto-Tunnel jika berjalan di server production dengan domain sendiri ("false")
# Set "true" jika ingin menggunakan tunnel otomatis cloudflared saat pengujian lokal
META_AUTO_TUNNEL="false"

# Domain publik server Anda untuk Webhook dan Short URL Redirect (tanpa garis miring di akhir)
# Contoh: https://protokol.gatsu51.com
PUBLIC_BASE_URL="https://your-domain.com"
