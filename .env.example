# ==============================================================================
# Database Configuration (PostgreSQL & SSH Tunnel)
# ==============================================================================
# Apakah database diakses melalui SSH Tunnel? ("true" atau "false")
SSH_ENABLED="true"

# Kredensial SSH Server / Bastion
SSH_HOST="your-ssh-host.com"
SSH_PORT="22"
SSH_USER="your-ssh-username"
SSH_PASSWORD="your-ssh-password"
# SSH_KEY_PATH="" # Opsional: path ke private key jika tidak menggunakan password

# Kredensial Database PostgreSQL (dilihat dari remote SSH server)
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_USER="your-db-user"
DB_PASSWORD="your-db-password"
DB_NAME="your-db-name"
DB_SCHEMA="public"

# Port lokal untuk forwarding SSH Tunnel (misal 5433 agar tidak bentrok dengan PostgreSQL lokal 5432)
DB_LOCAL_PORT="5433"

# URL Koneksi Prisma (Otomatis dibangun jika DB_USER diisi, atau atur manual jika diperlukan)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@127.0.0.1:5433/${DB_NAME}?schema=${DB_SCHEMA}&sslmode=prefer"
DIRECT_URL="postgresql://${DB_USER}:${DB_PASSWORD}@127.0.0.1:5433/${DB_NAME}?schema=${DB_SCHEMA}&sslmode=prefer"

# ==============================================================================
# 1. Konfigurasi Chat & Pemahaman Intention (OpenRouter - Free Model Tanpa Biaya)
# ==============================================================================
# API Key OpenRouter khusus untuk chat & understanding intention (misal dari https://openrouter.ai/settings/keys)
CHAT_API_KEY=""
# Model free OpenRouter (default: "openrouter/free" atau model berakhiran ":free")
CHAT_MODEL="openrouter/free"

# ==============================================================================
# 2. Konfigurasi Ekstraksi Dokumen PDF & Rekomendasi Perihal
# ==============================================================================
# Provider untuk ekstraksi PDF: "gemini" atau "openrouter"
PDF_EXTRACTION_PROVIDER="gemini"
# API Key khusus untuk ekstraksi PDF (misal Google Gemini API Key: AIzaSy...)
PDF_EXTRACTION_API_KEY=""
# Model khusus untuk ekstraksi PDF (misal "gemini-2.5-flash")
PDF_EXTRACTION_MODEL="gemini-2.5-flash"

# Admin Support Contact (Ditampilkan saat nomor tidak terdaftar)
ADMIN_CONTACT="0812-3456-7890 (Admin Tim IT Protokol)"

# Storage Paths
TEMP_STORAGE_PATH="./storage/temp"
PRIVATE_STORAGE_PATH="./storage/private"

# PWA Letter File Base URL
FILE_URL="https://pwa-protokol.gatsu51.com/files/letter/"

# ==============================================================================
# 3. Konfigurasi Cloudinary Storage (Penyimpanan Berkas PDF Surat Masuk)
# ==============================================================================
# Driver penyimpanan: "cloudinary" (default) atau "local"
STORAGE_DRIVER="cloudinary"
# Kredensial akun Cloudinary Anda (dapat dilihat di https://console.cloudinary.com/)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Opsi alternatif: menggunakan single URL Cloudinary (jika ada)
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
CLOUDINARY_FOLDER="letters"

